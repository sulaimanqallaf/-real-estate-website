# Copy this file to .env and fill in your real values.
# Never commit your real .env file.

# Telegram Bot API token, from @BotFather (see README for setup steps)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram chat id to send the daily report to (your user id, or a group/channel id)
TELEGRAM_CHAT_ID=123456789

# SEC EDGAR requires every automated requester to identify itself with a
# descriptive User-Agent (name + contact email/URL) - see
# https://www.sec.gov/os/webmaster-faq#developers. Used only for the 13F/Form 4
# provider in src/data_providers/sec_provider.py; leave unset to skip live SEC
# fetches entirely (they'll cleanly report "Data Unavailable" instead of
# crashing the run). Example format, do NOT use this literal value:
SEC_IDENTITY=Your Name or Company admin@example.com

# FRED (Federal Reserve Economic Data) API key for the macro context provider
# (src/data_providers/macro_provider.py). Free to request at
# https://fred.stlouisfed.org/docs/api/api_key.html. Leave unset to skip macro
# fetches entirely (clean "Data Unavailable", never a crash).
FRED_API_KEY=

# Alpaca Markets - free "Basic" market data plan (IEX feed only; see
# src/data_providers/alpaca_provider.py). Sign up free at
# https://alpaca.markets - no paid subscription, no credit card required
# for the Basic plan. Leave unset to skip Alpaca fetches entirely (clean
# "Data Unavailable", never a crash). This project never requests the
# paid "sip" consolidated feed - that is hardcoded off, not a setting here.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Overrides execution.mode from config/settings.yaml at runtime - the
# intended way to switch into IBKR_PAPER for local manual testing. Do NOT
# hand-edit config/settings.yaml for this; it must stay DRY_RUN for
# everyone who clones this repo. Only "DRY_RUN" and "IBKR_PAPER" are
# accepted - anything else (including "IBKR_LIVE") raises immediately at
# startup. Leave unset/blank to use whatever config/settings.yaml says.
EXECUTION_MODE=

# IBKR PAPER Trading connection (src/execution/ibkr_client.py) - Phase 7.
# NEVER a live account: this codebase has no supported "live" value anywhere
# and no override flag - see README "Autonomous IBKR PAPER Trading
# Execution Layer". Point these at your own LOCAL TWS or IB Gateway PAPER
# session; this file never needs (and this codebase never asks for) your
# IBKR username or password - TWS/Gateway handles that login itself.
#   TWS Paper default port:      7497
#   IB Gateway Paper default port: 4002
# (7496 and 4001 are the corresponding LIVE ports - never set these here.)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# Your own IBKR PAPER account id (starts with "DU"), e.g. DU1234567.
# Do NOT commit a real account id - leave this blank in any shared config;
# it belongs only in your local, gitignored .env.
IBKR_ACCOUNT_ID=
# There is only one supported value. Anything else fails closed.
IBKR_EXPECTED_ACCOUNT_MODE=PAPER
